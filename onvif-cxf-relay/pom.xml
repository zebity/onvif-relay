 <build>
  <plugins>

   <!-- 1. Generate OnvifOperations.java from downloaded ONVIF WSDLs -->
   <plugin>
    <groupId>org.codehaus.mojo</groupId>
    <artifactId>exec-maven-plugin</artifactId>
    <version>3.5.0</version>
    <executions>
     <execution>
      <id>mkdir-generated-operations</id>
      <phase>generate-sources</phase>
      <goals>
       <goal>exec</goal>
      </goals>
      <configuration>
       <executable>mkdir</executable>
       <arguments>
        <argument>-p</argument>
        <argument>${project.build.directory}/generated-sources/xsltproc/java/onvif_relay/relay/converters</argument>
       </arguments>
      </configuration>
     </execution>
     <execution>
      <id>generate-onvif-operations</id>
      <phase>generate-sources</phase>
      <goals>
       <goal>exec</goal>
      </goals>
      <configuration>
       <executable>xsltproc</executable>
       <arguments>
        <argument>--stringparam</argument>
        <argument>deviceWsdl</argument>
        <argument>${project.basedir}/../onvif-api/onvif-cxf-api/src/main/resources/META-INF/wsdl/www.onvif.org/ver10/device/wsdl/devicemgmt.wsdl</argument>
        <argument>--stringparam</argument>
        <argument>mediaWsdl</argument>
        <argument>${project.basedir}/../onvif-api/onvif-cxf-api/src/main/resources/META-INF/wsdl/www.onvif.org/ver10/media/wsdl/media.wsdl</argument>
        <argument>--stringparam</argument>
        <argument>ptzWsdl</argument>
        <argument>${project.basedir}/../onvif-api/onvif-cxf-api/src/main/resources/META-INF/wsdl/www.onvif.org/ver20/ptz/wsdl/ptz.wsdl</argument>
        <argument>--stringparam</argument>
        <argument>media2Wsdl</argument>
        <argument>${project.basedir}/../onvif-api/onvif-cxf-api/src/main/resources/META-INF/wsdl/www.onvif.org/ver20/media/wsdl/media.wsdl</argument>
        <argument>-o</argument>
        <argument>${project.build.directory}/generated-sources/xsltproc/java/onvif_relay/relay/converters/GeneratedOnvifOperations.java</argument>
        <argument>${project.basedir}/../onvif-api/src/main/xml/extract-operations-map-01.xml</argument>
        <argument>${project.basedir}/../onvif-api/src/main/xml/extract-operations-map-01.xml</argument>
       </arguments>
      </configuration>
     </execution>
    </executions>
   </plugin>

   <!-- 2. Register target/generated-sources/xsltproc/java as a Maven source root -->
   <plugin>
    <groupId>org.codehaus.mojo</groupId>
    <artifactId>build-helper-maven-plugin</artifactId>
    <version>3.6.0</version>
    <executions>
     <execution>
      <id>add-xsltproc-sources</id>
      <phase>generate-sources</phase>
      <goals>
       <goal>add-source</goal>
      </goals>
      <configuration>
       <sources>
        <source>${project.build.directory}/generated-sources/xsltproc/java</source>
       </sources>
      </configuration>
     </execution>
    </executions>
   </plugin>

   <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-dependency-plugin</artifactId>
    <version>3.3.0</version>
    <executions>
     <execution>
      <id>copy-dependencies</id>
      <phase>prepare-package</phase>
      <goals>
       <goal>copy-dependencies</goal>
      </goals>
      <configuration>
       <outputDirectory>
        ${project.build.directory}/libs
       </outputDirectory>
      </configuration>
     </execution>
    </executions>
   </plugin>

   <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-jar-plugin</artifactId>
    <version>3.3.0</version>
    <configuration>
     <archive>
      <manifest>
       <addClasspath>true</addClasspath>
       <classpathPrefix>libs/</classpathPrefix>
       <mainClass>
        onvif_relay.relay.server.EmbeddedJettyJakRelay
       </mainClass>
      </manifest>
     </archive>
    </configuration>
   </plugin>

  </plugins>
 </build>

</project>
